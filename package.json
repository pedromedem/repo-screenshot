{
  "name": "repo-screenshot",
  "version": "1.4.0",
  "description": "Capture desktop and mobile screenshots of GitHub repository homepages from the CLI or the local web UI.",
  "main": "server.js",
  "bin": {
    "repo-screenshot": "./cli.js"
  },
  "files": [
    "cli.js",
    "server.js",
    "lib",
    "public"
  ],
  "scripts": {
